{
  "name": "code-gloss",
  "displayName": "Code Gloss",
  "description": "Explains the code you highlight, in a panel beside your editor.",
  "version": "0.0.1",
  "publisher": "joshua-adille",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshua-adille/code-gloss"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeGloss.openPanel",
        "title": "Open Explanation Panel",
        "category": "Code Gloss"
      },
      {
        "command": "codeGloss.explainSelection",
        "title": "Explain Selection",
        "category": "Code Gloss"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "test": "vitest run",
    "test:smoke": "npm run build && vscode-test"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
